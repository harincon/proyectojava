# Credenciales reales: nunca al repositorio.
WEB-INF/jspf/conexion.jspf

# No versionar resultados generados por Tomcat.
*.class

# Archivos subidos por usuarios (documentos de solicitudes, fotos de perfil).
WEB-INF/archivos/

# Temporales del sistema y del editor.
Thumbs.db
desktop.ini
*.log
*.tmp

# Exportaciones sueltas de Figma; las imagenes en uso estan en img/habita/
img/*.png

# Originales pesados de las fotos del catálogo; en img/habita/ están las versiones reducidas.
varios/referencias/fotos-originales/

# Documentos de entrega que se comparten con el profesor por otro medio, no en el repositorio.
varios/documentacion/entrega/HISTORIAL_GIT.md
varios/documentacion/entrega/INFORME_PRUEBAS.md
varios/documentacion/entrega/INFORME_TECNICO_HABITA.pdf
varios/documentacion/entrega/PENDIENTES.md
varios/documentacion/entrega/PRESENTACION_HABITA.pptx
varios/documentacion/entrega/SCRUM_EVIDENCIA.md
varios/documentacion/entrega/evidencia/

# Bitácora interna de trabajo y plano visual de planificación: material de proceso, no de entrega.
README_IMPLEMENTACION.md
varios/planificacion/PLANO.html
